// tests/embedded_probe.nv — the codec on a microcontroller, as firmware
// that builds for a Cortex-M, boots there and checks its answers.
//
// `scripts/shard_audit.sh`'s `core-embedded` row copies this file and
// the module it names into a package of its own and runs
//
//   novo build --target=nrf52-qemu src/probe.nv
//
// which produces a Cortex-M4 ELF or fails.  The same ELF boots under
//
//   qemu-system-arm -machine mps2-an386 -nographic -semihosting -kernel probe.elf
//
// and writes `PASS: dns-codec-embedded` when every check holds.
//
// A device doing service discovery on a local link reads responses,
// compares the names in them and writes queries.  The checks below are
// that: a response decoded, a name compared and printed, a query built
// and read back, and a TCP stream split inside its length prefix.
//
// The module is `@tier(rt)`: a message is made of lists and boxed
// structs, so it needs the device's heap.
//
// Under novo 0.13.0 the ELF builds and prints `FAIL: dns-codec-embedded`.
// Five of the six checks hold.  The one that does not is `name_text` on
// a name read out of a decoded message: on the device it answers a
// control byte and a dot where the host answers `example.com.`.  The
// same call on a name decoded by `decode_name` alone answers correctly,
// and adding output between the calls changes the answer, so the fault
// is in the device build rather than in the codec.  The check stays,
// so the probe reports the fault until the toolchain is fixed.

use dns_codec

// A response for example.com: one question and one A record whose name
// is a pointer back to the question's name.
@tier(rt)
fn response() -> [u8]
    [0x12 as u8, 0x34 as u8, 0x81 as u8, 0x80 as u8,
     0x00 as u8, 0x01 as u8, 0x00 as u8, 0x01 as u8,
     0x00 as u8, 0x00 as u8, 0x00 as u8, 0x00 as u8,
     0x07 as u8, 0x65 as u8, 0x78 as u8, 0x61 as u8,
     0x6D as u8, 0x70 as u8, 0x6C as u8, 0x65 as u8,
     0x03 as u8, 0x63 as u8, 0x6F as u8, 0x6D as u8,
     0x00 as u8, 0x00 as u8, 0x01 as u8, 0x00 as u8,
     0x01 as u8,
     0xC0 as u8, 0x0C as u8, 0x00 as u8, 0x01 as u8,
     0x00 as u8, 0x01 as u8, 0x00 as u8, 0x00 as u8,
     0x0E as u8, 0x10 as u8, 0x00 as u8, 0x04 as u8,
     0x5D as u8, 0xB8 as u8, 0xD8 as u8, 0x22 as u8]

// The fourth octet of the first answer's address, or -1.
@tier(rt)
fn last_octet(msg: DnsMessage) -> Int
    if list.len(msg.answers) != 1
        return -1
    match msg.answers[0].data
        RdataA(octets) => octets[3] as Int
        _              => -1

// Every answer this probe checks, counted, so a device that disagrees
// with the host says how many it lost.
@tier(rt)
fn score() -> Int
    var n = 0
    match dns_codec.decode_message(response())
        Err(_)  =>
            n = n + 0
        Ok(msg) =>
            // The flags say a recursive response with no error.
            if msg.header.flags.response and msg.header.flags.recursion_available
                n = n + 1
            // The answer's address is 93.184.216.34.
            if last_octet(msg) == 34
                n = n + 1
            // The answer's name was a pointer, and it expands to the
            // question's name.
            if dns_codec.name_eq(msg.answers[0].name, msg.questions[0].name)
                n = n + 1
            // The name prints in presentation form.
            if dns_codec.name_text(msg.questions[0].name) == "example.com."
                n = n + 1
    // A query written and read back.
    match dns_codec.name_from_text("printer.local")
        Err(_)   =>
            n = n + 0
        Ok(name) =>
            let flags = dns_codec.decode_flags(0x0100)
            let query = DnsMessage {
                header: DnsHeader { id: 7, flags: flags, question_count: 1,
                                    answer_count: 0, authority_count: 0,
                                    additional_count: 0 },
                questions: [DnsQuestion { name: name, question_type: DnsTypeSrv,
                                          question_class: DnsClassInternet }],
                answers: [],
                authorities: [],
                additionals: [] }
            let wire = dns_codec.encode_message(query)
            if list.len(wire) == 12 + 15 + 4
                n = n + 1
    // A framed message split between the two bytes of its prefix.
    let framed = dns_codec.frame_tcp(response())
    let first = dns_codec.feed_tcp(dns_codec.tcp_reader(), framed[0:1])
    let second = dns_codec.feed_tcp(first.reader, framed[1:])
    match second.message
        None    =>
            n = n + 0
        Some(m) =>
            if list.len(m) == list.len(response())
                n = n + 1
    n

@tier(rt)
fn main() [hw, time]
    bsp.board.init()
    if score() == 6
        hal.uart.write("PASS: dns-codec-embedded\n")
    else
        hal.uart.write("FAIL: dns-codec-embedded\n")
    loop
        core.rt.sleep_ms(1000)
